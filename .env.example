# Скопируйте этот файл в .env.local (в корне проекта) и заполните значения.
# .env.local в git не попадает — пароли там безопасно.

# ---------------------------------------------------------------------------
# КУДА приходят заявки с сайта (ваш рабочий ящик Mail.ru / bk.ru / inbox.ru и т.д.)
# Может совпадать с SMTP_USER или быть другим.
# ---------------------------------------------------------------------------
MAIL_TO=Bekoev_2003@mail.ru

# ---------------------------------------------------------------------------
# Через какой ящик Mail.ru отправляем письмо (логин = полный email).
# Обычно тот же ящик, что и MAIL_TO.
# ---------------------------------------------------------------------------
SMTP_USER=Bekoev_2003@mail.ru

# Пароль для внешнего приложения (если включена защита / двухфакторка) —
# не обязательно совпадает с паролем входа в почту. Настройки:
# https://help.mail.ru/mail/security/protect/external
# Общая справка по SMTP: https://help.mail.ru/mail/mailer/popsmtp
SMTP_PASSWORD=ваш_пароль_для_внешнего_приложения_или_почты

# SMTP Почты Mail.ru (обычно не меняют)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465

# Другой сервис — замените HOST/PORT по инструкции провайдера.
